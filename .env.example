# App Configurations
APP_NAME="FinMind AI"
ENV="development"
DEBUG=True
PORT=8000

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL / TimescaleDB Database
POSTGRES_USER="finmind_user"
POSTGRES_PASSWORD="finmind_password"
POSTGRES_DB="finmind_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://finmind_user:finmind_password@localhost:5432/finmind_db"

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Vector Database (ChromaDB / Qdrant)
VECTOR_DB_TYPE="chroma"
CHROMA_PERSIST_DIR="./chroma_db"

# AI & LLM Provider Keys
OPENAI_API_KEY="your-openai-api-key-here"
HUGGINGFACE_TOKEN="your-huggingface-token-here"
